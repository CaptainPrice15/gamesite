# Copy to .env.local for local dev (never commit .env.local).
# On Vercel: Project Settings → Environment Variables.

# Browser-safe — Vite only exposes VITE_* vars to client code, and RLS keeps the
# anon key useless without a signed-in session.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — read by api/*.ts and NEVER shipped to the browser.
# NEVER give this the VITE_ prefix: a VITE_ service key would be inlined into
# the public JS bundle and would bypass every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional server-side names for the API. When unset, api/submitScore.ts falls
# back to the VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY values above.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional error tracking (Sentry). The SDK is dynamically imported only when
# this is set, so an unset value keeps it out of the bundle entirely.
# VITE_SENTRY_DSN=https://KEY@o0.ingest.sentry.io/0000000

# Optional privacy-friendly analytics (Umami) — both required to enable.
# No cookies, no personal data; page views + game-open events only.
# VITE_UMAMI_SRC=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
